# Copie para .env e preencha. Nunca versione .env.
# O ambiente real sempre vence: .env só preenche o que não estiver definido.

# --- MCP -> DeuxOrders Backend ---
# Aceita com ou sem o sufixo /api/v1.
BACKEND_URL=https://deux-erp.deuxcerie.com.br/api/v1
BACKEND_SERVICE_EMAIL=
BACKEND_SERVICE_PASSWORD=
BACKEND_TIMEOUT_MS=15000
BACKEND_RETRIES=2
# Teto do arquivo devolvido por dashboard.export-orders, em bytes.
BACKEND_MAX_EXPORT_BYTES=4194304

# --- Hermes -> MCP (HTTP) ---
# Bearer exigido em toda chamada MCP HTTP. Mínimo de 32 caracteres.
# Gere com: openssl rand -base64 48
MCP_AUTH_TOKEN=

# --- Servidor MCP HTTP ---
INVOKTA_HTTP_HOST=127.0.0.1
INVOKTA_HTTP_PORT=3000
# Obrigatório quando o bind não for loopback:
# INVOKTA_HTTP_ALLOWED_HOSTS=deuxorders-mcp.fly.dev
