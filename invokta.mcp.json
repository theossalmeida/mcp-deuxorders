{
  "schemaVersion": 1,
  "id": "deuxorders-mcp",
  "version": "0.1.0",
  "title": "DeuxOrders",
  "description": "Capabilities de operacao do DeuxOrders: clientes, pedidos, produtos, estoque, caixa e relatorios.",
