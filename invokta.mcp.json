    "clients.list-options",
    "clients.get",
    "clients.stats",
    "clients.list-orders",
    "clients.create",
    "clients.update",
    "clients.set-status",
    "clients.delete",
    "crm.list",
    "orders.search",
    "orders.get",
    "orders.create",
    "orders.update",
    "orders.complete",
    "orders.cancel",
    "orders.cancel-item",
    "orders.adjust-item-quantity",
    "orders.mark-paid",
    "orders.reverse-payment",
    "orders.remove-reference",
    "products.search",
    "products.list-options",
    "products.get",
    "products.stats",
    "products.create",
    "products.update",
    "products.set-status",
    "products.delete",
    "products.get-recipe",
    "products.set-recipe",
    "products.list-recipe-options",
    "products.set-recipe-option",
    "products.list-order-options",
    "inventory.search",
    "inventory.list-options",
    "inventory.get",
    "inventory.create",
    "inventory.update",
    "inventory.restock",
    "inventory.set-status",
    "cash.search",
    "cash.get",
    "cash.summary",
    "cash.create",
    "cash.update",
    "cash.delete",
    "cash.audit",
    "dashboard.summary",
    "dashboard.revenue-over-time",
    "dashboard.top-products",
    "dashboard.top-clients",
    "dashboard.export-orders"
