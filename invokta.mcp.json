  "server": {
    "name": "deuxorders-mcp",
    "entrypoint": "dist/mcp-stdio.js",
    "forwardEnv": [
      "BACKEND_URL",
      "BACKEND_SERVICE_EMAIL",
      "BACKEND_SERVICE_PASSWORD",
      "MCP_AUTH_TOKEN"
    ]
  }
}
